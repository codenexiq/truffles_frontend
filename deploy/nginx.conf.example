# /etc/nginx/sites-available/truffles-web   (replace example.com, then: sudo certbot --nginx -d example.com -d www.example.com)
# The Next.js app listens only on 127.0.0.1:3000; nginx is the single public entry point.
server {
    listen 80;
    server_name example.com www.example.com;

    # certbot rewrites this block to redirect to https and adds the certificate.
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite, never append client-supplied values
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
