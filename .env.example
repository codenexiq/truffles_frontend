# Truffles website configuration. Copy to .env.local and fill in. Never commit real values.

# REQUIRED for production builds: the https address of the Truffles API.
# (Development defaults to http://localhost:5001.)
NEXT_PUBLIC_BACKEND_URL=https://api.your-domain.com

# Public website address (used in links and metadata).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
